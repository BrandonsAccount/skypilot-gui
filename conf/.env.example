# 12-Factor: Config via environment variables
# Copy to .env.local for development.

# --- Feature flags ---
AUTH_ENABLED=false

# --- App ---
NODE_ENV=development
# Allowlist for upstream hosts the BFF may call (comma-separated host:port)
ALLOWLIST=localhost:9000

# --- Messenger service ---
# If unset, the app falls back to a local "dev echo" path so you can test immediately.
MESSENGER_URL=http://localhost:9000/messages
# Optional bearer for the Messenger service (not sent if empty)
MESSENGER_API_KEY=dev-messenger-token
MESSENGER_SUPPORTS_STREAM=true

# --- Auth (OIDC) ---
# Leave these empty when AUTH_ENABLED=false (default).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
SESSION_COOKIE_NAME=__Secure-nextchat.sid
SESSION_MAX_AGE_SECONDS=3600
ALLOWED_ROLES=customer,agent
